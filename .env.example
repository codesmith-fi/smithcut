# CutSmith – paikallisen kielimallin (Ollama) asetukset
OLLAMA_HOST=http://localhost:11434
CUTSMITH_MODEL=qwen3:8b

# Kuinka kauan Ollama pitää kielimallin ladattuna VRAM-muistissa pyynnön jälkeen.
# 8 Gt VRAM -näytönohjaimella arvo "15s" vapauttaa muistin nopeasti NVENC-vientiä varten;
# "5m" nopeuttaa peräkkäisiä chat-komentoja.
CUTSMITH_KEEP_ALIVE=5m

# Visuaalinen kohdistus (Vaihe 4 – VLM): paikantaa kohteet still-ruuduista.
# Asenna malli komennolla: ollama pull qwen2.5vl:3b
# KEEP_ALIVE="0" vapauttaa 8 Gt VRAM-muistin heti analyysin jälkeen.
CUTSMITH_VLM_MODEL=qwen2.5vl:3b
CUTSMITH_VLM_KEEP_ALIVE=0
